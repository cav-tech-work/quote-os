generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  QUOTE_USER
}

enum QuoteType {
  CLIENT
  VENDOR
}

enum QuoteStatus {
  DRAFT
  GENERATED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AuditAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
  GENERATED
  SENT
  STATUS_CHANGED
  IMPORTED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  role Role @default(QUOTE_USER)
  accessManager Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  quotes Quote[] @relation("Creator")
  events QuoteEvent[]
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

model CatalogueCategory {
  id String @id @default(cuid())
  name String
  parentId String?
  parent CatalogueCategory? @relation("Tree", fields: [parentId], references: [id])
  children CatalogueCategory[] @relation("Tree")
  items CatalogueItem[]
  @@unique([name, parentId])
}

model CatalogueItem {
  id String @id @default(cuid())
  code String @unique
  categoryId String
  category CatalogueCategory @relation(fields: [categoryId], references: [id])
  name String
  description String?
  manufacturer String?
  model String?
  vendorRatePaise Int
  clientRatePaise Int
  unit String @default("Per Day")
  discountEligible Boolean @default(true)
  taxCategory String?
  active Boolean @default(true)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines QuoteLine[]
}

model Quote {
  id String @id @default(cuid())
  number String @unique
  type QuoteType
  status QuoteStatus @default(DRAFT)
  company String
  project String?
  venue String?
  city String?
  salesperson String?
  currency String @default("INR")
  createdById String
  createdBy User @relation("Creator", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions QuoteRevision[]
  events QuoteEvent[]
}

model QuoteRevision {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  revisionNumber Int
  preparedDate DateTime
  validUntil DateTime?
  taxPercentage Decimal @db.Decimal(5, 2)
  notes String?
  termsSnapshot String?
  settingsSnapshot Json
  subtotalPaise Int
  discountTotalPaise Int
  taxTotalPaise Int
  grandTotalPaise Int
  lockedAt DateTime?
  createdAt DateTime @default(now())
  lines QuoteLine[]
  documents GeneratedDocument[]
  @@unique([quoteId, revisionNumber])
}

model QuoteLine {
  id String @id @default(cuid())
  revisionId String
  revision QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  catalogueItemId String?
  catalogueItem CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  itemCodeSnapshot String
  itemNameSnapshot String
  descriptionSnapshot String?
  unitSnapshot String
  quantity Decimal @db.Decimal(12, 2)
  days Decimal @db.Decimal(12, 2)
  rateUsedPaise Int
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountPaise Int
  lineTotalPaise Int
  remarks String?
}

model QuoteEvent {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id])
  action AuditAction
  fromValue String?
  toValue String?
  metadata Json?
  createdAt DateTime @default(now())
}

model GeneratedDocument {
  id String @id @default(cuid())
  revisionId String
  revision QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  templateVersion String
  storageKey String @unique
  checksum String
  generatedAt DateTime @default(now())
  emailedAt DateTime?
}
